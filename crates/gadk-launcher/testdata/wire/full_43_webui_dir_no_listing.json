{
  "name": "full_43_webui_dir_no_listing",
  "server": "full",
  "launcher": "full",
  "args": [
    "web",
    "-port",
    "<port>",
    "-max_request_body_size",
    "1024",
    "-allow_origins",
    "http://allowed.example",
    "api",
    "webui",
    "a2a",
    "pubsub",
    "eventarc"
  ],
  "kind": "exchange",
  "request": {
    "method": "GET",
    "target": "/ui/assets/",
    "headers": [
      [
        "Host",
        "127.0.0.1:<port>"
      ],
      [
        "Connection",
        "close"
      ]
    ],
    "body": ""
  },
  "response": {
    "status": 404,
    "status_text": "Not Found",
    "headers": [
      [
        "Connection",
        "close"
      ],
      [
        "Content-Length",
        "19"
      ],
      [
        "Content-Type",
        "text/plain; charset=utf-8"
      ],
      [
        "Date",
        "<date>"
      ],
      [
        "X-Content-Type-Options",
        "nosniff"
      ]
    ],
    "body": "404 page not found\n",
    "body_length": 19,
    "body_sha256": null,
    "base_href": null
  },
  "log": [
    "<ts> GET /ui/assets/ <elapsed>"
  ],
  "exit_status": null,
  "stdout": null,
  "error": null
}
