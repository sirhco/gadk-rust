{
  "name": "full_24_api_redirect_head",
  "server": "full",
  "launcher": "full",
  "args": [
    "web",
    "-port",
    "<port>",
    "-max_request_body_size",
    "1024",
    "-allow_origins",
    "http://allowed.example",
    "api",
    "webui",
    "a2a",
    "pubsub",
    "eventarc"
  ],
  "kind": "exchange",
  "request": {
    "method": "HEAD",
    "target": "/api/health%2F",
    "headers": [
      [
        "Host",
        "127.0.0.1:<port>"
      ],
      [
        "Connection",
        "close"
      ]
    ],
    "body": ""
  },
  "response": {
    "status": 301,
    "status_text": "Moved Permanently",
    "headers": [
      [
        "Access-Control-Allow-Headers",
        "Content-Type, Authorization"
      ],
      [
        "Access-Control-Allow-Methods",
        "GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS"
      ],
      [
        "Access-Control-Allow-Origin",
        "http://localhost:8080"
      ],
      [
        "Connection",
        "close"
      ],
      [
        "Content-Type",
        "text/html; charset=utf-8"
      ],
      [
        "Date",
        "<date>"
      ],
      [
        "Location",
        "/api/health"
      ],
      [
        "Vary",
        "Origin"
      ]
    ],
    "body": "",
    "body_length": 0,
    "body_sha256": null,
    "base_href": null
  },
  "log": [
    "<ts> HEAD /api/health%2F <elapsed>"
  ],
  "exit_status": null,
  "stdout": null,
  "error": null
}
