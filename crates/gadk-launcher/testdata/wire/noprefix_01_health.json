{
  "name": "noprefix_01_health",
  "server": "noprefix",
  "launcher": "full",
  "args": [
    "web",
    "-port",
    "<port>",
    "api",
    "-path_prefix="
  ],
  "kind": "exchange",
  "request": {
    "method": "GET",
    "target": "/health",
    "headers": [
      [
        "Host",
        "127.0.0.1:<port>"
      ],
      [
        "Connection",
        "close"
      ]
    ],
    "body": ""
  },
  "response": {
    "status": 200,
    "status_text": "OK",
    "headers": [
      [
        "Connection",
        "close"
      ],
      [
        "Content-Length",
        "16"
      ],
      [
        "Content-Type",
        "application/json"
      ],
      [
        "Date",
        "<date>"
      ]
    ],
    "body": "{\"status\":\"ok\"}\n",
    "body_length": 16,
    "body_sha256": null,
    "base_href": null
  },
  "log": [
    "<ts> GET /health <elapsed>"
  ],
  "exit_status": null,
  "stdout": null,
  "error": null
}
