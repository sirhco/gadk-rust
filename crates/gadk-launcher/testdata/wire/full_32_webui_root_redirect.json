{
  "name": "full_32_webui_root_redirect",
  "server": "full",
  "launcher": "full",
  "args": [
    "web",
    "-port",
    "<port>",
    "-max_request_body_size",
    "1024",
    "-allow_origins",
    "http://allowed.example",
    "api",
    "webui",
    "a2a",
    "pubsub",
    "eventarc"
  ],
  "kind": "exchange",
  "request": {
    "method": "GET",
    "target": "/",
    "headers": [
      [
        "Host",
        "127.0.0.1:<port>"
      ],
      [
        "Connection",
        "close"
      ]
    ],
    "body": ""
  },
  "response": {
    "status": 302,
    "status_text": "Found",
    "headers": [
      [
        "Connection",
        "close"
      ],
      [
        "Content-Length",
        "27"
      ],
      [
        "Content-Type",
        "text/html; charset=utf-8"
      ],
      [
        "Date",
        "<date>"
      ],
      [
        "Location",
        "/ui/"
      ]
    ],
    "body": "<a href=\"/ui/\">Found</a>.\n\n",
    "body_length": 27,
    "body_sha256": null,
    "base_href": null
  },
  "log": [
    "<ts> GET / <elapsed>"
  ],
  "exit_status": null,
  "stdout": null,
  "error": null
}
