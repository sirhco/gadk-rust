{
  "name": "full_27_api_body_too_large",
  "server": "full",
  "launcher": "full",
  "args": [
    "web",
    "-port",
    "<port>",
    "-max_request_body_size",
    "1024",
    "-allow_origins",
    "http://allowed.example",
    "api",
    "webui",
    "a2a",
    "pubsub",
    "eventarc"
  ],
  "kind": "exchange",
  "request": {
    "method": "POST",
    "target": "/api/apps/assistant/users/u1/sessions",
    "headers": [
      [
        "Host",
        "127.0.0.1:<port>"
      ],
      [
        "Content-Type",
        "application/json"
      ],
      [
        "Content-Length",
        "2072"
      ],
      [
        "Connection",
        "close"
      ]
    ],
    "body": "{\"state\":{\"padding\":\"\"}}"
  },
  "response": {
    "status": 400,
    "status_text": "Bad Request",
