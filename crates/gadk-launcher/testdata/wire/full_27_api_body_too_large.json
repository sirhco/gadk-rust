      ],
      [
        "Connection",
        "close"
      ],
      [
        "Content-Length",
        "29"
      ],
      [
        "Content-Type",
        "text/plain; charset=utf-8"
      ],
      [
        "Date",
        "<date>"
      ],
      [
        "Vary",
        "Origin"
      ],
      [
        "X-Content-Type-Options",
        "nosniff"
      ]
