{
  "name": "full_36_webui_index_file",
  "server": "full",
  "launcher": "full",
  "args": [
    "web",
    "-port",
    "<port>",
    "-max_request_body_size",
    "1024",
    "-allow_origins",
    "http://allowed.example",
    "api",
    "webui",
    "a2a",
    "pubsub",
    "eventarc"
  ],
  "kind": "exchange",
  "request": {
    "method": "GET",
    "target": "/ui/index.html",
    "headers": [
      [
        "Host",
        "127.0.0.1:<port>"
      ],
      [
        "Connection",
        "close"
      ]
    ],
    "body": ""
  },
  "response": {
    "status": 301,
    "status_text": "Moved Permanently",
    "headers": [
      [
        "Connection",
        "close"
      ],
      [
        "Content-Length",
        "0"
      ],
      [
        "Date",
        "<date>"
      ],
      [
        "Location",
        "./"
      ]
    ],
    "body": "",
    "body_length": 0,
    "body_sha256": null,
    "base_href": null
  },
  "log": [
    "<ts> GET /ui/index.html <elapsed>"
  ],
  "exit_status": null,
  "stdout": null,
  "error": null
}
