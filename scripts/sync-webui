#!/usr/bin/env python3
# Copyright 2026 Chris Olson — Apache-2.0 (see LICENSE)
"""Vendors ADK-Go's prebuilt web UI bundle into gadk-launcher (R12).

Usage:
  sync-webui [--check]

Copies $ADK_GO_DIR/cmd/launcher/web/webui/distr (default ADK_GO_DIR: ../adk-go next to this
repository) byte for byte to crates/gadk-launcher/webui/distr/, refusing unless it holds exactly
EXPECTED_FILES files; writes crates/gadk-launcher/webui/SHA256SUMS (`sha256sum` format, sorted,
paths relative to distr/); and generates crates/gadk-launcher/src/web/webui/assets.rs, the
`include_bytes!` manifest the `webui` sub-launcher serves.

--check writes nothing and exits 1 if the vendored copy, SHA256SUMS or assets.rs differ from
what a sync would write. With ADK-Go present the source of truth is its distr/; without it (and
without ADK_GO_DIR set) the vendored copy is checked against the committed SHA256SUMS.

The bundle is a google/adk-web build (Apache-2.0, Copyright Google LLC) committed in ADK-Go;
ADK-Go ships no separate LICENSE/NOTICE or third-party license file for it.

Standard library only; safe to run with `python3 -I`.
"""

import hashlib
import os
import shutil
import sys
from pathlib import Path

EXPECTED_FILES = 106

REPO = Path(__file__).resolve().parent.parent
LAUNCHER = REPO / "crates" / "gadk-launcher"
DST = LAUNCHER / "webui" / "distr"
SUMS = LAUNCHER / "webui" / "SHA256SUMS"
ASSETS = LAUNCHER / "src" / "web" / "webui" / "assets.rs"
# include_bytes! paths are relative to assets.rs.
ASSETS_TO_DISTR = "../../../webui/distr"
GO_DISTR = Path("cmd") / "launcher" / "web" / "webui" / "distr"

HEADER = """\
// Copyright 2026 Chris Olson
// Portions derived from ADK-Go (https://github.com/google/adk-go), Copyright 2026 Google LLC.
//
// Licensed under the Apache License, Version 2.0 (the "License");
// you may not use this file except in compliance with the License.
// You may obtain a copy of the License at
//
//     http://www.apache.org/licenses/LICENSE-2.0
//
// Unless required by applicable law or agreed to in writing, software
// distributed under the License is distributed on an "AS IS" BASIS,
// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
// See the License for the specific language governing permissions and
// limitations under the License.

//! The embedded ADK web UI bundle (ADK-Go `cmd/launcher/web/webui/distr`, a google/adk-web
//! build), vendored at `crates/gadk-launcher/webui/distr`.
//!
//! Generated by `scripts/sync-webui`; do not edit. Run `scripts/sync-webui` to regenerate it and
//! `scripts/sync-webui --check` to verify it.
"""


def die(msg):
    print(f"sync-webui: {msg}", file=sys.stderr)
    sys.exit(1)


def list_files(root):
    """Regular files under root as sorted '/'-separated relative paths."""
    out = []
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        dirnames.sort()
        for d in dirnames:
            if os.path.islink(os.path.join(dirpath, d)):
                die(f"refusing symlinked directory {os.path.join(dirpath, d)}")
        for name in filenames:
            p = os.path.join(dirpath, name)
            if os.path.islink(p) or not os.path.isfile(p):
                die(f"refusing non-regular file {p}")
            out.append(Path(p).relative_to(root).as_posix())
    return sorted(out)


def sha256(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def render_sums(hashes):
    return "".join(f"{hashes[rel]}  {rel}\n" for rel in sorted(hashes))


def parse_sums(text):
    hashes = {}
    for n, line in enumerate(text.splitlines(), 1):
        digest, sep, rel = line.partition("  ")
        if not sep or len(digest) != 64 or not rel:
            die(f"{SUMS}:{n}: malformed line")
        hashes[rel] = digest
    return hashes


def render_assets(paths):
    entries = "".join(
        f'    (\n        "{rel}",\n        include_bytes!("{ASSETS_TO_DISTR}/{rel}"),\n    ),\n'
        for rel in sorted(paths)
    )
    return (
        HEADER
        + "\n/// The bundle, `(path relative to distr/, bytes)`, sorted by path.\n"
        + "pub(crate) static ASSETS: &[(&str, &[u8])] = &[\n"
        + entries
        + "];\n"
    )


def check_rel(rel):
    # Paths go verbatim into Rust string literals and SHA256SUMS lines.
    if any(c in rel for c in '"\\\n') or not rel.isascii():
        die(f"unsupported file name {rel!r}")


def source_dir():
    """ADK-Go's distr/, or None when ADK-Go is absent and ADK_GO_DIR is unset."""
    env = os.environ.get("ADK_GO_DIR")
    go = Path(env) if env else REPO.parent / "adk-go"
    src = go / GO_DISTR
    if src.is_dir():
        return src
    if env:
        die(f"{src} does not exist (ADK_GO_DIR={env})")
    return None


def sync(src):
    files = list_files(src)
    if len(files) != EXPECTED_FILES:
        die(f"refusing: expected {EXPECTED_FILES} files under {src}, found {len(files)}")
    for rel in files:
        check_rel(rel)
    if DST.exists():
        shutil.rmtree(DST)
    hashes = {}
    for rel in files:
        target = DST / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(src / rel, target)
        hashes[rel] = sha256(target)
    SUMS.write_text(render_sums(hashes), encoding="utf-8", newline="\n")
    ASSETS.parent.mkdir(parents=True, exist_ok=True)
    ASSETS.write_text(render_assets(files), encoding="utf-8", newline="\n")
    print(f"synced {len(files)} files from {src}")


def check(src):
    problems = []
    vendored = list_files(DST) if DST.is_dir() else []
    if src is not None:
        files = list_files(src)
        if len(files) != EXPECTED_FILES:
            problems.append(f"expected {EXPECTED_FILES} files under {src}, found {len(files)}")
        hashes = {rel: sha256(src / rel) for rel in files}
        origin = str(src)
    else:
        if not SUMS.is_file():
            die(f"{SUMS} is missing and ADK-Go is not available")
        hashes = parse_sums(SUMS.read_text(encoding="utf-8"))
        files = sorted(hashes)
        origin = str(SUMS)
    if len(vendored) != EXPECTED_FILES:
        problems.append(f"expected {EXPECTED_FILES} files under {DST}, found {len(vendored)}")
    for rel in sorted(set(files) - set(vendored)):
        problems.append(f"missing from the vendored copy: {rel}")
    for rel in sorted(set(vendored) - set(files)):
        problems.append(f"not in {origin}: {rel}")
    for rel in sorted(set(files) & set(vendored)):
        if sha256(DST / rel) != hashes[rel]:
            problems.append(f"differs from {origin}: {rel}")
    if not SUMS.is_file() or SUMS.read_text(encoding="utf-8") != render_sums(hashes):
        problems.append(f"{SUMS} is stale")
    if not ASSETS.is_file() or ASSETS.read_text(encoding="utf-8") != render_assets(files):
        problems.append(f"{ASSETS} is stale")
    for p in problems:
        print(f"sync-webui: {p}", file=sys.stderr)
    if problems:
        print("sync-webui: run scripts/sync-webui to regenerate", file=sys.stderr)
        sys.exit(1)
    print(f"ok: {len(vendored)} web UI files match {origin}")


def main(argv):
    if argv not in ([], ["--check"]):
        print("usage: sync-webui [--check]", file=sys.stderr)
        sys.exit(2)
    src = source_dir()
    if argv == ["--check"]:
        check(src)
    elif src is None:
        die(f"ADK-Go not found at {REPO.parent / 'adk-go'}; set ADK_GO_DIR")
    else:
        sync(src)


if __name__ == "__main__":
    main(sys.argv[1:])
