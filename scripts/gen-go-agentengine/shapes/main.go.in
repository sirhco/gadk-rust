// Command zzgadkshapes writes gadk-server's encode_shapes.rs to stdout: the
// shape (fields, json tags, kinds) of every Go struct reachable from
// session.Event and the agentengine request/response models.
//
// It imports server/agentengine/internal/models, so it only compiles inside
// ADK-Go's server/agentengine tree: scripts/gen-go-agentengine --shapes places
// this file there with `go run -overlay` (ADK-Go's working tree is not
// modified). The only argument is the ADK-Go commit (first 8 hex digits) for
// the generated header.
package main

import (
	"encoding/json"
	"fmt"
	"os"
	"reflect"
	"sort"
	"strings"
	"time"

	"google.golang.org/adk/v2/server/agentengine/internal/models"
	"google.golang.org/adk/v2/session"
)

const header = `// Copyright 2026 Chris Olson
// Portions derived from ADK-Go (https://github.com/google/adk-go), Copyright 2026 Google LLC.
//
// Licensed under the Apache License, Version 2.0 (the "License");
// you may not use this file except in compliance with the License.
// You may obtain a copy of the License at
//
//     http://www.apache.org/licenses/LICENSE-2.0
//
// Unless required by applicable law or agreed to in writing, software
// distributed under the License is distributed on an "AS IS" BASIS,
// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
// See the License for the specific language governing permissions and
// limitations under the License.
//! Go struct shapes for ` + "`ConvertSnake` and `json.Unmarshal`: every struct reachable from" + `
//! ` + "`session.Event` and the agentengine request/response models (`internal/models`)." + `
//!
//! GENERATED by ` + "`go run ./scripts/gen-go-agentengine --shapes` (ADK-Go `%s`)" + `. DO NOT EDIT.
#![allow(dead_code)]

use super::encode::{GoField, GoKind, GoStruct};
`

var (
	rawMessageType = reflect.TypeOf(json.RawMessage(nil))
	timeType       = reflect.TypeOf(time.Time{})
	stringType     = reflect.TypeOf("")
)

// roots are session.Event and the 14 internal/models types (C.10).
var roots = []any{
	session.Event{},
	models.Query{},
	models.CreateSessionRequest{},
	models.CreateSessionResponse{},
	models.GetSessionRequest{},
	models.GetSessionResponse{},
	models.ListSessionRequest{},
	models.ListSessionResponse{},
	models.DeleteSessionRequest{},
	models.DeleteSessionResponse{},
	models.StreamQueryRequest{},
	models.StreamQueryTextRequest{},
	models.StreamingAgentRunWithEventsRequest{},
	models.StreamingAgentRunWithEventsRunRequest{},
	models.StreamingAgentRunWithEventsResponse{},
}

// structs maps reflect.Type.String() to every struct type reached.
var structs = map[string]reflect.Type{}

func walk(t reflect.Type) {
	if t == rawMessageType || t == timeType {
		return
	}
	switch t.Kind() {
	case reflect.Pointer, reflect.Slice, reflect.Array, reflect.Map:
		walk(t.Elem())
	case reflect.Struct:
		if prev, ok := structs[t.String()]; ok {
			if prev != t {
				fail("two struct types named %s", t.String())
			}
			return
		}
		structs[t.String()] = t
		for i := 0; i < t.NumField(); i++ {
			walk(t.Field(i).Type)
		}
	}
}

// kind renders t as a Rust GoKind expression (C.10 kind mapping, first match).
func kind(t reflect.Type) string {
	switch {
	case t == rawMessageType:
		return "GoKind::RawMessage"
	case t == timeType:
		return "GoKind::Time"
	}
	switch t.Kind() {
	case reflect.Pointer:
		return "GoKind::Pointer(&" + kind(t.Elem()) + ")"
	case reflect.Slice:
		if t.Elem().Kind() == reflect.Uint8 {
			return "GoKind::Bytes"
		}
		return "GoKind::Slice(&" + kind(t.Elem()) + ")"
	case reflect.Array:
		return "GoKind::Slice(&" + kind(t.Elem()) + ")"
	case reflect.Map:
		if t.Key().Kind() != reflect.String {
			fail("map with a non-string key: %s", t.String())
		}
		return "GoKind::Map(&" + kind(t.Elem()) + ")"
	case reflect.Struct:
		return "GoKind::Struct(" + rustStr(t.String()) + ")"
	case reflect.Interface:
		return "GoKind::Interface"
	case reflect.String:
		if t == stringType {
			return "GoKind::String"
		}
		return "GoKind::NamedString"
	case reflect.Bool:
		return "GoKind::Bool"
	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
		return "GoKind::Int"
	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr:
		return "GoKind::Uint"
	case reflect.Float32:
		return "GoKind::Float32"
	case reflect.Float64:
		return "GoKind::Float64"
	}
	fail("unsupported kind %s of %s", t.Kind(), t.String())
	return ""
}

// convertName is ADK-Go's helper.convertName (encode.go) without the
// pathToName exceptions.
func convertName(name string) string {
	l := strings.ToLower(name)
	b := &strings.Builder{}
	afterUnderscore := true
	for i := 0; i < len(name); i++ {
		if !afterUnderscore && i > 0 && i+1 < len(name) && name[i] != l[i] && name[i+1] == l[i+1] {
			fmt.Fprintf(b, "_%c", l[i])
			afterUnderscore = true
			continue
		}
		if !afterUnderscore && i+1 < len(name) && name[i] == l[i] && name[i+1] != l[i+1] {
			fmt.Fprintf(b, "%c_", l[i])
			afterUnderscore = true
			continue
		}
		afterUnderscore = false
		fmt.Fprintf(b, "%c", l[i])
	}
	return b.String()
}

// constName is UPPER(pkg) + "_" + UPPER(convertName(TypeName)).
func constName(goType string) string {
	pkg, name, ok := strings.Cut(goType, ".")
	if !ok {
		fail("unqualified struct type %s", goType)
	}
	return strings.ToUpper(pkg) + "_" + strings.ToUpper(convertName(name))
}

func rustStr(s string) string {
	s = strings.ReplaceAll(s, `\`, `\\`)
	s = strings.ReplaceAll(s, `"`, `\"`)
	return `"` + s + `"`
}

func fail(format string, args ...any) {
	fmt.Fprintf(os.Stderr, "zzgadkshapes: "+format+"\n", args...)
	os.Exit(1)
}

func main() {
	if len(os.Args) != 2 {
		fail("usage: zzgadkshapes <ADK-Go commit, 8 hex>")
	}
	for _, r := range roots {
		walk(reflect.TypeOf(r))
	}
	names := make([]string, 0, len(structs))
	for n := range structs {
		names = append(names, n)
	}
	sort.Strings(names)

	consts := map[string]string{}
	for _, n := range names {
		c := constName(n)
		if other, ok := consts[c]; ok {
			fail("constant %s names both %s and %s", c, other, n)
		}
		consts[c] = n
	}

	var b strings.Builder
	fmt.Fprintf(&b, header, os.Args[1])
	for _, n := range names {
		t := structs[n]
		fmt.Fprintf(&b, "\n/// Go `%s`.\n", n)
		fmt.Fprintf(&b, "pub(crate) const %s: GoStruct = GoStruct {\n", constName(n))
		fmt.Fprintf(&b, "    go_type: %s,\n", rustStr(n))
		if t.NumField() == 0 {
			b.WriteString("    fields: &[],\n")
		} else {
			b.WriteString("    fields: &[\n")
			for i := 0; i < t.NumField(); i++ {
				f := t.Field(i)
				fmt.Fprintf(&b, "        GoField { name: %s, tag: %s, embedded: %t, exported: %t, go_type: %s, kind: %s },\n",
					rustStr(f.Name), rustStr(f.Tag.Get("json")), f.Anonymous, f.IsExported(), rustStr(f.Type.String()), kind(f.Type))
			}
			b.WriteString("    ],\n")
		}
		b.WriteString("};\n")
	}
	b.WriteString("\n/// Every shape, sorted by `go_type`.\n")
	b.WriteString("pub(crate) const ALL: &[&GoStruct] = &[\n")
	for _, n := range names {
		fmt.Fprintf(&b, "    &%s,\n", constName(n))
	}
	b.WriteString("];\n")
	if _, err := os.Stdout.WriteString(b.String()); err != nil {
		fail("%v", err)
	}
}
